{
  "provider": "anthropic",
  "api": "anthropic-messages",
  "id": "claude-haiku-5-5",
  "name": "Claude Haiku 5.5",
  "reasoning": true,
  "input": [
    "text",
    "image"
  ],
  "contextWindow": 1000000,
  "maxTokens": 128000,
  "thinkingLevelMap": {
    "off": null,
    "minimal": null,
    "low": "low",
    "medium": "medium",
    "high": "high",
    "xhigh": "xhigh",
    "max": "max"
  },
  "defaultThinkingLevel": "medium",
  "compat": {
    "forceAdaptiveThinking": true,
    "supportsTemperature": false,
    "supportsMidConvoEffort": true
  },
  "cost": {
    "input": 0.1,
    "output": 0.5,
    "cacheRead": 0.01,
    "cacheWrite": 0.125,
    "tiers": [
      {
        "inputTokensAbove": 100000,
        "input": 0.5,
        "output": 2.5,
        "cacheRead": 0.05,
        "cacheWrite": 0.625
      }
    ]
  }
}
