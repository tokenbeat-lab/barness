 account that produced them, or in an account linked to it.\"]}],[\"$\",\"p\",\"1\",{\"children\":[\"For code changes, see the \",[\"$\",\"$Le4\",\"1\",{\"href\":\"/docs/en/models/haiku-5-5/migration-guide\",\"untracked\":false,\"children\":[\"migration guide\"]}],\". For model IDs, pricing, and limits, see the \",[\"$\",\"$Le4\",\"3\",{\"href\":\"/docs/en/models/haiku-5-5/overview\",\"untracked\":false,\"children\":[\"Claude Haiku 5.5 overview\"]}],\". For prompting guidance, see \",[\"$\",\"$Le4\",\"5\",{\"href\":\"/docs/en/build-with-claude/prompt-engineering/prompting-claude-haiku-5-5\",\"untracked\":false,\"children\":[\"Prompting Claude Haiku 5.5\"]}],\".\"]}]],[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le5\",null,{\"href\":\"/docs/en/models/haiku-5-5/whats-new-haiku-5-5\",\"inheritColor\":false,\"icon\":\"ArrowRight\",\"children\":\"What’s new in Claude Haiku 5.5\"}]}]]}],\"\\n\",[\"$\",\"h2\",\"6\",{\"id\":\"how-it-compares\",\"className\":\"group\",\"children\":[[\"How it compares\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Le3\",null,{\"id\":\"how-it-compares\",\"name\":\"How it compares\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}],\"\\n\",\"$Le6\",\"\\n\",[\"$\",\"h2\",\"10\",{\"id\":\"specifications\",\"className\":\"group\",\"children\":[[\"Specifications\"],[\"$\",\"span\",null,{\"className\":\"relative hidden h-[1em] w-0 align-middle lg:inline-block\",\"children\":[\"$\",\"$Le3\",null,{\"id\":\"specifications\",\"name\":\"Specifications\",\"className\":\"absolute top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[copied]:opacity-100 touch:opacity-100\"}]}]]}],\"\\n\",\"$Le7\",\"\\n\",[\"$\",\"h2\",\"14\",{\"id\":\"good-to-know\",\"className\":\"group\",\"children\":[[\"Good to know\"],[\"$\",\"span\",null,{\"className