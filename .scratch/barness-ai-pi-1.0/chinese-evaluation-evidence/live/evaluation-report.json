  "dataset": {
    "version": "zh-support-v1",
    "source": "synthetic",
    "scope": "简体中文在线商店支持请求：仅限四类明确请求目标；不包含闲聊、其他语言或无法判定的请求。",
    "annotationPolicy": "由维护者编写的合成任务真值。依据用户最后明确请求的处理目标，而非被否定或作为背景的主题。支付/发票归 billing；登录/账号访问归 account；其余软件故障归 technical；物流配送归 delivery。每条只有一个明确目标；多目标及不确定输入不在本任务范围。不是生产用户总体的人工标注真值。",
    "count": 24,
    "distribution": {
      "account": 6,
      "billing": 6,
      "delivery": 6,
      "technical": 6
    },
    "labels": {
      "account": "登录、密码、账号绑定或账号访问问题。",
      "billing": "付款、重复扣款、退款或发票问题。",
      "delivery": "包裹、发货、物流进度、签收或配送问题。",
      "technical": "软件故障、异常提示、页面或功能无法正常使用；排除支付和登录问题。"
    },
    "samples": [
      {
        "id": "billing-01",
        "text": "订单扣了两次钱，请退回多收的一笔。",
        "label": "billing",
        "rationale": "明确请求目标属于付款、重复扣款、退款或发票问题。"
      },
      {
        "id": "billing-02",
        "text": "钱已付清，但电子发票一直没有开出来。",
        "label": "billing",
        "rationale": "明确请求目标属于付款、重复扣款、退款或发票问题。"
      },
      {
        "id": "billing-03",
        "text": "退款申请通过了，款项还没到账，麻烦查询。",
        "label": "billing",
        "rationale": "明确请求目标属于付款、重复扣款、退款或发票问题。"
      },
      {
        "id": "billing-04",
        "text": "不是物流的问题，我只想问为什么付款失败。",
        "label": "billing",
        "rationale": "明确请求目标属于付款、重复扣款、退款或发票问题。"
      },
      {
        "id": "billing-05",
        "text": "商品已经收到，我要把发票抬头改成公司名称。",
        "label": "billing",
        "rationale": "明确请求目标属于付款、重复扣款、退款或发票问题。"
      },
      {
        "id": "billing-06",
        "text": "登录和页面都正常，结算时却提示银行卡扣款失败。",
        "label": "billing",
        "rationale": "明确请求目标属于付款、重复扣款、退款或发票问题。"
      },
      {
        "id": "technical-01",
        "text": "点击保存按钮后程序就闪退，内容也丢了。",
        "label": "technical",
        "rationale": "明确请求目标属于软件故障、异常提示、页面或功能无法正常使用；排除支付和登录问题。"
      },
      {
        "id": "technical-02",
        "text": "报表页面一直转圈，刷新后仍然打不开。",
        "label": "technical",
        "rationale": "明确请求目标属于软件故障、异常提示、页面或功能无法正常使用；排除支付和登录问题。"
      },
      {
        "id": "technical-03",
        "text": "升级以后搜索功能失效，输入关键词没有反应。",
        "label": "technical",
        "rationale": "明确请求目标属于软件故障、异常提示、页面或功能无法正常使用；排除支付和登录问题。"
      },
      {
        "id": "technical-04",
        "text": "能正常登录，但下载文件时总提示服务器异常。",
        "label": "technical",
        "rationale": "明确请求目标属于软件故障、异常提示、页面或功能无法正常使用；排除支付和登录问题。"
      },
      {
        "id": "technical-05",
        "text": "不涉及付款，设置页面点哪个按钮都没反应。",
        "label": "technical",
        "rationale": "明确请求目标属于软件故障、异常提示、页面或功能无法正常使用；排除支付和登录问题。"
      },
      {
        "id": "technical-06",
        "text": "物流状态看得到，只是应用的通知开关无法保存。",
        "label": "technical",
        "rationale": "明确请求目标属于软件故障、异常提示、页面或功能无法正常使用；排除支付和登录问题。"
      },
      {
        "id": "delivery-01",
        "text": "包裹三天没有更新物流，能查一下到哪里了吗？",
        "label": "delivery",
        "rationale": "明确请求目标属于包裹、发货、物流进度、签收或配送问题。"
      },
      {
        "id": "delivery-02",
        "text": "页面显示已签收，可我根本没收到快递。",
        "label": "delivery",
        "rationale": "明确请求目标属于包裹、发货、物流进度、签收或配送问题。"
      },
      {
        "id": "delivery-03",
        "text": "订单付款成功了，请问什么时候发货？",
        "label": "delivery",
        "rationale": "明确请求目标属于包裹、发货、物流进度、签收或配送问题。"
      },
      {
        "id": "delivery-04",
        "text": "快递员去了旧地址，能帮我更改配送地址吗？",
        "label": "delivery",
        "rationale": "明确请求目标属于包裹、发货、物流进度、签收或配送问题。"
      },
      {
        "id": "delivery-05",
        "text": "不用退款，我只是想催一下迟到的包裹。",
        "label": "delivery",
        "rationale": "明确请求目标属于包裹、发货、物流进度、签收或配送问题。"
      },
      {
        "id": "delivery-06",
        "text": "发票已经收到了，商品却还没有寄出，请查发货进度。",
        "label": "delivery",
        "rationale": "明确请求目标属于包裹、发货、物流进度、签收或配送问题。"
      },
      {
        "id": "account-01",
        "text": "忘记登录密码了，请帮我找回账号。",
        "label": "account",
        "rationale": "明确请求目标属于登录、密码、账号绑定或账号访问问题。"
      },
      {
        "id": "account-02",
        "text": "换了手机号，原账号收不到登录验证码。",
        "label": "account",
        "rationale": "明确请求目标属于登录、密码、账号绑定或账号访问问题。"
      },
      {
        "id": "account-03",
        "text": "账号被锁住，无法进入个人中心，想申请解锁。",
        "label": "account",
        "rationale": "明确请求目标属于登录、密码、账号绑定或账号访问问题。"
      },
      {
        "id": "account-04",
        "text": "旧邮箱停用了，怎样更换账号绑定邮箱？",
        "label": "account",
        "rationale": "明确请求目标属于登录、密码、账号绑定或账号访问问题。"
      },
      {
        "id": "account-05",
        "text": "不是程序闪退，是密码错误导致我无法登录。",
        "label": "account",
        "rationale": "明确请求目标属于登录、密码、账号绑定或账号访问问题。"
      },
      {
        "id": "account-06",
        "text": "付款记录不用查询，我现在只需要恢复被停用账号的访问权限。",
        "label": "account",
        "rationale": "明确请求目标属于登录、密码、账号绑定或账号访问问题。"
      }
