{
 "case": "P02/E03 Anthropic × Messages history, tool round trip, thinking replay and images",
 "source": "Synthetic offline fixture. Each scenario is a host's history in the test host's storage shape (see history_fixture_test.go decodeStoredMessage; trusted marks messages whose envelope the host vouches for, on the tenant's account at the message's provider) and the request body frozen pi-ai 0.87.1 (commit 898ab804050730e9dcefb4443875d5a932aa6a32) sends for it: packages/ai/src/api/transform-messages.ts transformMessages (same-/cross-model thinking and text, tool call id normalization with Anthropic's normalizeToolCallId, image placeholders, error turns, synthetic results) and packages/ai/src/api/anthropic-messages.ts convertMessages / convertToolResult / convertContentBlocks / convertTools (signed and redacted thinking replay, blank text dropped, consecutive tool results in one user message, cache_control on the last user block). Native state is replayed only under a trusted envelope (spec I6); otherwise the message follows the cross-model rules and the downgrade is counted.",
 "scenarios": [
  {
   "id": "tool-round-trip",
   "about": "A same-model turn with signed thinking, text and a tool call, answered by the host's tool result: thinking is replayed with its signature, the call as tool_use with its parsed input, the result as a tool_result in a user message carrying the cache marker.",
   "model": "claude-haiku-4-5",
   "context": {
    "tools": [{"name": "lookup", "description": "Look something up.", "parameters": {"type": "object", "properties": {"q": {"type": "string"}}, "required": ["q"]}}],
    "messages": [
     {"role": "user", "content": [{"type": "text", "text": "Look up x."}]},
     {"role": "assistant", "trusted": true, "api": "anthropic-messages", "provider": "anthropic", "model": "claude-haiku-4-5", "stopReason": "toolUse", "timestamp": 1,
      "content": [{"type": "thinking", "thinking": "Let me think", "thinkingSignature": "sig-abc"}, {"type": "text", "text": "Hi there"}, {"type": "toolCall", "id": "toolu_01", "name": "lookup", "arguments": {"q": "x"}}]},
     {"role": "toolResult", "toolCallId": "toolu_01", "toolName": "lookup", "content": [{"type": "text", "text": "42"}], "isError": false}
    ]
   },
   "events": [
    {"type": "message_start", "message": {"id": "msg_h", "usage": {"input_tokens": 40, "output_tokens": 1, "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0}}},
    {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}},
    {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "It is 42."}},
    {"type": "content_block_stop", "index": 0},
    {"type": "message_delta", "delta": {"stop_reason": "end_turn"}, "usage": {"output_tokens": 4}},
    {"type": "message_stop"}
   ],
   "expect": {
    "request": {
     "path": "/v1/messages",
     "query": "beta=true",
     "body": {
      "model": "claude-haiku-4-5",
      "messages": [
       {"role": "user", "content": [{"type": "text", "text": "Look up x."}]},
       {"role": "assistant", "content": [{"type": "thinking", "thinking": "Let me think", "signature": "sig-abc"}, {"type": "text", "text": "Hi there"}, {"type": "tool_use", "id": "toolu_01", "name": "lookup", "input": {"q": "x"}}]},
       {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_01", "content": "42", "is_error": false, "cache_control": {"type": "ephemeral"}}]}
      ],
      "max_tokens": 64000,
      "stream": true,
      "tools": [{"name": "lookup", "description": "Look something up.", "eager_input_streaming": true, "input_schema": {"type": "object", "properties": {"q": {"type": "string"}}, "required": ["q"]}, "cache_control": {"type": "ephemeral"}}]
     }
    },
    "stopReason": "stop",
    "rawStopReason": "end_turn",
    "responseId": "msg_h",
    "content": [{"type": "text", "text": "It is 42."}],
    "downgrades": {}
   }
  },
