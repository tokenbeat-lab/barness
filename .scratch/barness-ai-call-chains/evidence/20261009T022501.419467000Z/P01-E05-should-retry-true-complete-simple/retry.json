      "expect": {"requests": 1, "sleepsMs": [], "stopReason": "error", "code": "upstream_auth", "phase": "request", "httpStatus": 403,
        "errorMessage": "OpenAI API error (403): {\"message\":\"Forbidden\",\"type\":\"invalid_request_error\",\"code\":null}",
        "attempts": [{"httpStatus": 403, "code": "upstream_auth"}]}
    },
    {
