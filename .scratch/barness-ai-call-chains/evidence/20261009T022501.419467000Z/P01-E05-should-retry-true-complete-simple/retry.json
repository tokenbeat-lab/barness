      "expect": {"requests": 1, "sleepsMs": [], "stopReason": "error", "code": "upstream_auth", "phase": "request", "httpStatus": 401,
        "errorMessage": "OpenAI API error (401): {\"message\":\"Invalid key\",\"type\":\"invalid_request_error\",\"code\":\"invalid_api_key\"}",
        "attempts": [{"httpStatus": 401, "code": "upstream_auth"}]}
    },
    {
      "id": "auth-403-not-retried",
