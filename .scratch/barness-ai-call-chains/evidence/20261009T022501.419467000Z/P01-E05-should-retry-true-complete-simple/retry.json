{
  "case": "E05 explicit retry of the initial request on OpenAI × Responses",
  "source": "Synthetic offline fixture. The logical input and the successful reply are text-basic.json's. Retry decisions, delays and the refused-delay message follow pi-ai 0.87.1 (commit 898ab804050730e9dcefb4443875d5a932aa6a32) utils/provider-retry.ts as called by api/openai-responses.ts; HTTP error bodies follow the OpenAI API error object. The clock is fake: it starts at now, every jitter draw is jitter, and sleeps return at once.",
  "now": "2026-10-02T00:00:00Z",
  "jitter": 0.4,
  "scenarios": [
    {
      "id": "default-no-retry",
      "note": "maxRetries defaults to 0: a retryable 503 is sent once, and the SDK adds no retry of its own.",
      "replies": [{"status": 503, "body": "{\"error\":{\"message\":\"The server is overloaded\",\"type\":\"server_error\",\"code\":null}}"}],
      "expect": {"requests": 1, "sleepsMs": [], "stopReason": "error", "code": "upstream_error", "phase": "request", "httpStatus": 503,
        "errorMessage": "OpenAI API error (503): {\"message\":\"The server is overloaded\",\"type\":\"server_error\",\"code\":null}",
        "attempts": [{"httpStatus": 503, "code": "upstream_error"}]}
    },
    {
      "id": "default-retry-after-date",
      "pidiffSkip": "pi reads the date against its real clock; the reported delay is a barness extension anyway.",
      "note": "Without retries the provider's requested delay is still reported; an HTTP date is converted with the clock.",
      "replies": [{"status": 429, "header": {"retry-after": "Fri, 02 Oct 2026 00:00:05 GMT"}, "body": "{\"error\":{\"message\":\"Rate limit reached\",\"type\":\"requests\",\"code\":\"rate_limit_exceeded\"}}"}],
      "expect": {"requests": 1, "sleepsMs": [], "stopReason": "error", "code": "rate_limited", "phase": "request", "httpStatus": 429, "retryAfterMs": 5000,
        "errorMessage": "OpenAI API error (429): {\"message\":\"Rate limit reached\",\"type\":\"requests\",\"code\":\"rate_limit_exceeded\"}",
        "attempts": [{"httpStatus": 429, "code": "rate_limited"}]}
    },
    {
      "id": "backoff-then-success",
      "note": "Exponential backoff from 500ms, doubled per retry, lowered by jitter×25%.",
      "retry": {"maxRetries": 3},
      "replies": [{"status": 503, "body": "{\"error\":{\"message\":\"The server is overloaded\",\"type\":\"server_error\",\"code\":null}}"},
        {"status": 500, "body": "{\"error\":{\"message\":\"Internal error\",\"type\":\"server_error\",\"code\":null}}"},
        {"ok": true}],
      "expect": {"requests": 3, "sleepsMs": [450, 900], "stopReason": "stop", "responses": 1,
        "attempts": [{"httpStatus": 503, "code": "upstream_error", "retryDelayMs": 450}, {"httpStatus": 500, "code": "upstream_error", "retryDelayMs": 900}, {"httpStatus": 200}]}
    },
    {
      "id": "retries-exhausted",
      "note": "After maxRetries the last attempt's failure ends the call.",
      "retry": {"maxRetries": 2},
      "replies": [{"status": 500, "body": "{\"error\":{\"message\":\"Internal error\",\"type\":\"server_error\",\"code\":null}}"},
        {"status": 502, "body": "Bad gateway"},
        {"status": 503, "header": {"x-request-id": "req_503last"}, "body": "{\"error\":{\"message\":\"The server is overloaded\",\"type\":\"server_error\",\"code\":null}}"}],
      "expect": {"requests": 3, "sleepsMs": [450, 900], "stopReason": "error", "code": "upstream_error", "phase": "request", "httpStatus": 503, "providerRequestId": "req_503last",
        "errorMessage": "OpenAI API error (503): {\"message\":\"The server is overloaded\",\"type\":\"server_error\",\"code\":null}",
        "attempts": [{"httpStatus": 500, "code": "upstream_error", "retryDelayMs": 450}, {"httpStatus": 502, "code": "upstream_error", "retryDelayMs": 900}, {"httpStatus": 503, "code": "upstream_error", "providerRequestId": "req_503last"}]}
    },
    {
      "id": "should-retry-false",
      "note": "x-should-retry: false wins over a retryable status.",
      "retry": {"maxRetries": 2},
      "replies": [{"status": 503, "header": {"x-should-retry": "false"}, "body": "{\"error\":{\"message\":\"The server is overloaded\",\"type\":\"server_error\",\"code\":null}}"}],
      "expect": {"requests": 1, "sleepsMs": [], "stopReason": "error", "code": "upstream_error", "phase": "request", "httpStatus": 503,
        "errorMessage": "OpenAI API error (503): {\"message\":\"The server is overloaded\",\"type\":\"server_error\",\"code\":null}",
        "attempts": [{"httpStatus": 503, "code": "upstream_error"}]}
    },
    {
      "id": "should-retry-true",
      "note": "x-should-retry: true wins over a status that is not retried.",
      "retry": {"maxRetries": 1},
      "replies": [{"status": 400, "header": {"x-should-retry": "true"}, "body": "{\"error\":{\"message\":\"Try again\",\"type\":\"invalid_request_error\",\"code\":null}}"}, {"ok": true}],
      "expect": {"requests": 2, "sleepsMs": [450], "stopReason": "stop", "responses": 1,
        "attempts": [{"httpStatus": 400, "code": "invalid_request", "retryDelayMs": 450}, {"httpStatus": 200}]}
    },
    {
      "id": "retryable-statuses",
      "note": "408, 409 and 429 are retried like 5xx.",
      "retry": {"maxRetries": 3},
      "replies": [{"status": 408, "body": "{\"error\":{\"message\":\"Request timeout\"}}"},
        {"status": 409, "body": "{\"error\":{\"message\":\"Conflict\"}}"},
        {"status": 429, "body": "{\"error\":{\"message\":\"Rate limit reached\",\"type\":\"requests\",\"code\":\"rate_limit_exceeded\"}}"},
        {"ok": true}],
      "expect": {"requests": 4, "sleepsMs": [450, 900, 1800], "stopReason": "stop", "responses": 1,
        "attempts": [{"httpStatus": 408, "code": "upstream_error", "retryDelayMs": 450}, {"httpStatus": 409, "code": "upstream_error", "retryDelayMs": 900}, {"httpStatus": 429, "code": "rate_limited", "retryDelayMs": 1800}, {"httpStatus": 200}]}
    },
    {
      "id": "auth-401-not-retried",
      "note": "401 is not retried, and never with another key.",
