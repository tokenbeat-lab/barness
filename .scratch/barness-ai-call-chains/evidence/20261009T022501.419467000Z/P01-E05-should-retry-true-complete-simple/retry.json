      "expect": {"requests": 1, "sleepsMs": [], "stopReason": "error", "code": "invalid_request", "phase": "request", "httpStatus": 400,
        "errorMessage": "OpenAI API error (400): {\"message\":\"Bad input\",\"type\":\"invalid_request_error\",\"code\":null}",
        "attempts": [{"httpStatus": 400, "code": "invalid_request"}]}
    },
    {
      "id": "retry-after-ms-first",
      "note": "retry-after-ms is taken before retry-after.",
      "retry": {"maxRetries": 1},
      "replies": [{"status": 429, "header": {"retry-after-ms": "1500", "retry-after": "9"}, "body": "{\"error\":{\"message\":\"Rate limit reached\"}}"}, {"ok": true}],
      "expect": {"requests": 2, "sleepsMs": [1500], "stopReason": "stop", "responses": 1,
        "attempts": [{"httpStatus": 429, "code": "rate_limited", "retryDelayMs": 1500}, {"httpStatus": 200}]}
    },
    {
      "id": "retry-after-seconds",
      "retry": {"maxRetries": 1},
      "replies": [{"status": 503, "header": {"retry-after": "3"}, "body": "{\"error\":{\"message\":\"busy\"}}"}, {"ok": true}],
      "expect": {"requests": 2, "sleepsMs": [3000], "stopReason": "stop", "responses": 1,
        "attempts": [{"httpStatus": 503, "code": "upstream_error", "retryDelayMs": 3000}, {"httpStatus": 200}]}
    },
    {
      "id": "retry-after-date",
      "pidiffSkip": "pi would wait until the fixture's date on its real clock.",
      "note": "An HTTP date is measured from the clock's now.",
      "retry": {"maxRetries": 1},
      "replies": [{"status": 503, "header": {"retry-after": "Fri, 02 Oct 2026 00:00:05 GMT"}, "body": "{\"error\":{\"message\":\"busy\"}}"}, {"ok": true}],
      "expect": {"requests": 2, "sleepsMs": [5000], "stopReason": "stop", "responses": 1,
