    {"id":"C04-unary-callbacks","source":"issue 07 / ADR-0006/0008","requirement":"One frozen request callback per logical call, invalid callback rejection and host cause Is/As preserved","scenarios":["P07"],"cases":"unary-(callback|invalid|frozen)"},
