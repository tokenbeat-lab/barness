{
 "case": "P03/E11 Google × Gemini Developer API usage, cache reads, thinking tokens, completeness and cost",
 "source": "Synthetic offline fixture. Usage follows pi-ai 0.87.1 (commit 898ab804050730e9dcefb4443875d5a932aa6a32) google-generative-ai.ts: each usageMetadata replaces the usage (input = prompt - cached, output = candidates + thoughts, cacheRead = cached, reasoning = thoughts, totalTokens = Gemini's total) and calculateCost prices it at the frozen model data's rates. Completeness is barness's (ADR-0012).",
 "scenarios": [
  {
   "id": "usage-cached-thinking",
   "about": "Cached prompt tokens are cache reads outside input; thinking tokens are output and reported again as the reasoning subset; the total is Gemini's.",
   "model": "gemini-2.5-pro",
   "context": {
    "messages": [
     {
      "role": "user",
      "content": [
       {
        "type": "text",
        "text": "Hi"
       }
      ]
     }
    ]
   },
   "events": [
    {
     "candidates": [
      {
       "index": 0,
       "content": {
        "parts": [
         {
          "text": "Hi"
         }
        ],
        "role": "model"
       }
      }
     ],
     "usageMetadata": {
      "promptTokenCount": 1000,
      "totalTokenCount": 1000
     }
    },
    {
     "candidates": [
      {
       "index": 0,
       "content": {
        "parts": [
         {
          "text": "!"
         }
        ],
        "role": "model"
       },
       "finishReason": "STOP"
      }
     ],
     "usageMetadata": {
      "promptTokenCount": 1000,
      "cachedContentTokenCount": 400,
      "candidatesTokenCount": 50,
      "thoughtsTokenCount": 30,
      "totalTokenCount": 1080
     }
    }
   ],
   "expect": {
    "stopReason": "stop",
    "rawStopReason": "STOP",
    "usage": {
     "input": 600,
     "output": 80,
     "cacheRead": 400,
     "cacheWrite": 0,
     "reasoning": 30,
     "totalTokens": 1080,
     "cost": {
      "input": 0.00075,
      "output": 0.0008,
      "cacheRead": 4.9999999999999996e-05,
      "cacheWrite": 0,
      "total": 0.0016
     }
    },
    "usageReporting": "complete"
   }
  },
