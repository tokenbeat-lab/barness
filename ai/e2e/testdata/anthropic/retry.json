   "maxRetries": 2,
   "replies": [
    {
     "events": [
      {
       "type": "message_start",
       "message": {
        "id": "msg_retry",
        "usage": {
         "input_tokens": 40,
         "output_tokens": 1,
         "cache_read_input_tokens": 0,
         "cache_creation_input_tokens": 0
        }
       }
      },
      {
       "type": "content_block_start",
       "index": 0,
       "content_block": {
        "type": "text",
        "text": ""
       }
      },
      {
       "type": "content_block_delta",
       "index": 0,
