{
 "case": "P02/E05 Anthropic × Messages explicit retry of the initial request",
 "source": "Synthetic offline fixture. Retries follow pi-ai 0.87.1 (commit 898ab804050730e9dcefb4443875d5a932aa6a32) packages/ai/src/utils/provider-retry.ts retryProviderRequest around the Anthropic SDK call made with maxRetries 0 (x-should-retry first, then 408/409/429/5xx; retry-after-ms, retry-after; a requested delay above maxRetryDelayMs fails with 'Server requested Ns retry delay (max: Ms). <SDK message>'); maxRetries is the binding's retry policy in barness (ADR-0006) and pi's maxRetries option on the pi side.",
 "scenarios": [
  {
   "id": "retry-429-then-success",
   "about": "With one retry configured, a 429 asking for 5 ms is retried once and the second attempt streams; the message's usage is the streamed attempt's.",
   "model": "claude-haiku-4-5",
   "context": {
    "messages": [
     {
      "role": "user",
      "content": [
       {
        "type": "text",
        "text": "Hi"
       }
      ]
     }
    ]
   },
   "maxRetries": 1,
   "replies": [
    {
     "status": 429,
     "header": {
      "retry-after-ms": "5"
     },
     "body": "{\"type\":\"error\",\"error\":{\"type\":\"rate_limit_error\",\"message\":\"Rate limited\"}}"
    },
    {
     "events": [
      {
       "type": "message_start",
       "message": {
        "id": "msg_retry",
        "usage": {
         "input_tokens": 40,
         "output_tokens": 1,
         "cache_read_input_tokens": 0,
         "cache_creation_input_tokens": 0
        }
       }
      },
      {
       "type": "content_block_start",
       "index": 0,
       "content_block": {
        "type": "text",
        "text": ""
       }
      },
      {
       "type": "content_block_delta",
       "index": 0,
       "delta": {
        "type": "text_delta",
        "text": "Done."
       }
      },
      {
       "type": "content_block_stop",
       "index": 0
      },
      {
       "type": "message_delta",
       "delta": {
        "stop_reason": "end_turn"
       },
       "usage": {
        "output_tokens": 2
       }
      },
      {
       "type": "message_stop"
      }
     ]
    }
   ],
   "expect": {
    "stopReason": "stop",
    "rawStopReason": "end_turn",
    "responseId": "msg_retry",
    "content": [
     {
      "type": "text",
      "text": "Done."
     }
    ],
    "requests": 2,
    "usage": {
     "input": 40,
     "output": 2,
     "cacheRead": 0,
     "cacheWrite": 0,
     "cacheWrite1h": 0,
     "totalTokens": 42,
     "cost": {
      "input": 3.9999999999999996e-05,
      "output": 1e-05,
      "cacheRead": 0,
      "cacheWrite": 0,
      "total": 4.9999999999999996e-05
     }
    },
    "usageReporting": "complete"
   }
  },
  {
   "id": "x-should-retry-false",
   "about": "x-should-retry: false wins over a retryable status: one request.",
   "model": "claude-haiku-4-5",
   "context": {
    "messages": [
     {
      "role": "user",
      "content": [
       {
        "type": "text",
        "text": "Hi"
       }
      ]
     }
    ]
   },
   "maxRetries": 2,
   "replies": [
    {
     "status": 529,
     "header": {
      "x-should-retry": "false"
     },
     "body": "{\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}"
    }
   ],
   "expect": {
    "events": [
     "error:error"
    ],
    "stopReason": "error",
    "errorMessage": "529 {\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}",
    "code": "upstream_error",
    "phase": "request",
    "httpStatus": 529,
    "content": []
   }
  },
  {
   "id": "retry-delay-refused",
   "about": "A requested delay over the 60 s cap fails the call at once with pi's message quoting the SDK's error.",
   "model": "claude-haiku-4-5",
   "context": {
    "messages": [
     {
      "role": "user",
      "content": [
       {
        "type": "text",
        "text": "Hi"
       }
      ]
     }
    ]
   },
   "maxRetries": 1,
   "replies": [
    {
     "status": 429,
     "header": {
      "retry-after": "120"
     },
     "body": "{\"type\":\"error\",\"error\":{\"type\":\"rate_limit_error\",\"message\":\"Rate limited\"}}"
